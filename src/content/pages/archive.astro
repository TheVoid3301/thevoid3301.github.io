
---
import { getCollection } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

const categoryNames: Record<string, string> = {
  algorithms: '算法学习',
  infra: 'Infra',
  projects: '项目实践',
  research: '科研笔记',
  notes: '碎碎念',
};

const articles = (await getCollection('docs'))
  .filter(({ id, data }) => {
    const category = id.split('/')[0];

    return (
      category in categoryNames &&
      id !== 'index' &&
      !id.endsWith('/index') &&
      data.draft !== true &&
      data.date instanceof Date
    );
  })
  .map((entry) => {
    const { id, data } = entry;
    const category = id.split('/')[0];
    const date = data.date as Date;

    const slug = (data.slug || id)
      .replace(/\/index$/, '')
      .replace(/^\/|\/$/g, '');

    return {
      title: data.title,
      description: data.description || '',
      href: `/${slug}/`,
      category,
      categoryName: categoryNames[category],
      tags: data.tags || [],
      date,
      dateText: date.toISOString().slice(0, 10),
      year: date.getUTCFullYear(),
    };
  })
  .sort((a, b) => b.date.getTime() - a.date.getTime());

const tags = [...new Set(
  articles.flatMap((article) => article.tags)
)].sort();

const years = [...new Set(
  articles.map((article) => article.year)
)].sort((a, b) => b - a);
---

<StarlightPage
  frontmatter={{
    title: '文章归档',
    description: '按分类、标签与时间探索我的学习记录。',
  }}
>
  <h1>Article Archive_</h1>
  <p>记录每一步学习与探索。</p>

  <div class="archive-filters">
    <label>
      分类
      <select id="filter-category">
        <option value="">全部分类</option>
        {Object.entries(categoryNames).map(([value, label]) => (
          <option value={value}>{label}</option>
        ))}
      </select>
    </label>

    <label>
      标签
      <select id="filter-tag">
        <option value="">全部标签</option>
        {tags.map((tag) => (
          <option value={tag}>{tag}</option>
        ))}
      </select>
    </label>
  </div>

  {years.map((year) => (
    <section class="archive-year" data-year-group>
      <h2>{year}</h2>

      <div class="archive-list">
        {articles
          .filter((article) => article.year === year)
          .map((article) => (
            <article
              class="archive-entry"
              data-entry
              data-category={article.category}
              data-tags={JSON.stringify(article.tags)}
            >
              <time datetime={article.dateText}>
                {article.dateText}
              </time>

              <h3>
                <a href={article.href}>
                  {article.title}
                </a>
              </h3>

              <p>{article.description}</p>

              <div class="archive-tags">
                <span>{article.categoryName}</span>
                {article.tags.map((tag) => (
                  <span>#{tag}</span>
                ))}
              </div>
            </article>
          ))}
      </div>
    </section>
  ))}

  <p id="archive-empty" hidden>
    没有找到符合条件的文章。
  </p>
</StarlightPage>

<script>
  const categorySelect = document.querySelector<HTMLSelectElement>(
    '#filter-category'
  );

  const tagSelect = document.querySelector<HTMLSelectElement>(
    '#filter-tag'
  );

  function updateArticles() {
    const category = categorySelect?.value || '';
    const tag = tagSelect?.value || '';

    let visibleCount = 0;

    document.querySelectorAll<HTMLElement>('[data-entry]').forEach((entry) => {
      const articleTags: string[] = JSON.parse(
        entry.dataset.tags || '[]'
      );

      const categoryMatches =
        !category || entry.dataset.category === category;

      const tagMatches =
        !tag || articleTags.includes(tag);

      entry.hidden = !(categoryMatches && tagMatches);

      if (!entry.hidden) visibleCount++;
    });

    document.querySelectorAll<HTMLElement>('[data-year-group]').forEach(
      (group) => {
        const visibleArticles = group.querySelector(
          '[data-entry]:not([hidden])'
        );

        group.hidden = !visibleArticles;
      }
    );

    const empty = document.querySelector<HTMLElement>('#archive-empty');
    if (empty) empty.hidden = visibleCount > 0;
  }

  categorySelect?.addEventListener('change', updateArticles);
  tagSelect?.addEventListener('change', updateArticles);
  updateArticles();
</script>

<style>
  .archive-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 2rem 0;
  }

  .archive-filters label {
    flex: 1;
    min-width: 150px;
  }

  .archive-filters select {
    display: block;
    width: 100%;
    margin-top: 0.5rem;
    padding: 0.6rem;
    color: var(--sl-color-text);
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
  }

  .archive-year {
    margin-top: 2.5rem;
  }

  .archive-list {
    border-left: 2px solid var(--sl-color-accent);
    padding-left: 1.3rem;
    margin-top: 1rem;
  }

  .archive-entry {
    position: relative;
    margin: 0 0 1.8rem;
  }

  .archive-entry::before {
    content: '';
    position: absolute;
    left: calc(-1.3rem - 5px);
    top: 0.35rem;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--sl-color-accent);
  }

  .archive-entry time {
    color: var(--sl-color-gray-3);
    font-size: 0.8rem;
  }

  .archive-entry h3 {
    margin: 0.4rem 0;
  }

  .archive-entry p {
    color: var(--sl-color-gray-3);
    margin: 0.4rem 0;
    font-size: 0.9rem;
  }

  .archive-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.5rem;
  }

  .archive-tags span {
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 6px;
    font-size: 0.75rem;
    color: var(--sl-color-accent);
  }

  [hidden] {
    display: none !important;
  }
</style>
